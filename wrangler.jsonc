// Cloudflare deploy settings for postbypost.app.
// site/ is the static website; worker/index.mjs only handles /api/*.
{
  "name": "post-by-post",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  // Keep variables added in the Cloudflare dashboard (e.g. PADDLE_API_KEY) when
  // deploying from GitHub, instead of resetting them to the list below.
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Live Paddle account.
    "PADDLE_ENV": "production",
    "PRO_PRICE_ID": "pri_01m4cc8gaek1hq4njx5237rd7n"
  }
  // PADDLE_API_KEY is a secret: set it in the Cloudflare dashboard, never here.
}
